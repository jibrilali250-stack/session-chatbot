        </mxCell>
        <mxCell id="llm-func-text" value="→ {text, input_tokens, output_tokens,&#xa;     seconds, tokens_per_second, cost}" style="text;html=1;align=left;fontSize=8;spacingLeft=15;fontFamily=Courier New;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="595" y="465" width="270" height="25" as="geometry" />
        </mxCell>
        
        <mxCell id="llm-providers" value="Supported: OpenAI, Anthropic, Groq,&#xa;Gemini, Mistral, OpenRouter" style="text;html=1;align=left;fontSize=9;spacingLeft=15;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="595" y="495" width="270" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="llm-model" value="MODEL = env.LAB_MODEL" style="text;html=1;align=left;fontSize=9;spacingLeft=15;fontFamily=Courier New;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="595" y="525" width="270" height="15" as="geometry" />
        </mxCell>
        
        <!-- Configuration Files -->
        <mxCell id="config-section" value="Configuration &amp; Data Files" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="220" y="580" width="660" height="120" as="geometry" />
        </mxCell>
        
        <mxCell id="config-env-detail" value=".env" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=10;align=left;spacingLeft=8;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="230" y="610" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="config-env-text" value="API keys (6 providers)&#xa;LAB_MODEL, MAX_HISTORY_TURNS,&#xa;GUARDRAILS_FILE, FRONTEND_ORIGIN" style="text;html=1;align=left;fontSize=8;spacingLeft=15;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="235" y="615" width="190" height="35" as="geometry" />
        </mxCell>
        
        <mxCell id="config-gj" value="guardrails.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=10;align=left;spacingLeft=8;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="450" y="610" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="config-gj-text" value="enabled, max_input_chars,&#xa;injection_phrases, mask_pii,&#xa;max_output_words, etc." style="text;html=1;align=left;fontSize=8;spacingLeft=15;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="455" y="615" width="190" height="35" as="geometry" />
        </mxCell>
        
        <mxCell id="config-pj" value="prompts.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=10;align=left;spacingLeft=8;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="670" y="610" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="config-pj-text" value="topic_judge system prompt" style="text;html=1;align=left;fontSize=8;spacingLeft=15;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="675" y="615" width="190" height="15" as="geometry" />
        </mxCell>
        
        <!-- Additional Notes -->
        <mxCell id="notes-box" value="Key Implementation Details" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="100" y="120" width="80" height="600" as="geometry" />
        </mxCell>
        <mxCell id="note1" value="• CORS enabled for frontend origin" style="text;html=1;align=left;fontSize=9;spacingLeft=5;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="105" y="150" width="70" height="30" as="geometry" />
        </mxCell>
        <mxCell id="note2" value="• MAX_HISTORY_TURNS limits context" style="text;html=1;align=left;fontSize=9;spacingLeft=5;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="105" y="200" width="70" height="40" as="geometry" />
        </mxCell>
        <mxCell id="note3" value="• Guardrails run before &amp; after LLM" style="text;html=1;align=left;fontSize=9;spacingLeft=5;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="105" y="260" width="70" height="40" as="geometry" />
        </mxCell>
        <mxCell id="note4" value="• Blocked messages not saved to session" style="text;html=1;align=left;fontSize=9;spacingLeft=5;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="105" y="320" width="70" height="40" as="geometry" />
        </mxCell>
        <mxCell id="note5" value="• Session store is in-memory (lost on restart)" style="text;html=1;align=left;fontSize=9;spacingLeft=5;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="105" y="380" width="70" height="50" as="geometry" />
        </mxCell>
        <mxCell id="note6" value="• Error codes: 404 (not found), 422 (bad input), 502 (LLM fail)" style="text;html=1;align=left;fontSize=9;spacingLeft=5;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="105" y="450" width="70" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  
  <diagram id="request-flow" name="3. Chat Request Flow">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Title -->
        <mxCell id="title3" value="POST /chat Request Flow" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="300" y="30" width="500" height="40" as="geometry" />
        </mxCell>
        
        <!-- Client Request -->
        <mxCell id="step0" value="Client Request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="100" y="100" width="180" height="40" as="geometry" />
        </mxCell>
        <mxCell id="step0-text" value="POST /chat&#xa;{session_id, message}" style="text;html=1;align=center;fontSize=10;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="105" y="105" width="170" height="30" as="geometry" />
        </mxCell>
        
        <!-- Step 1: Session Validation -->
        <mxCell id="step1" value="1. Session Validation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="100" y="170" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="step1-text" value="if session_id provided:&#xa;  check if exists in sessions{}&#xa;  → 404 if not found&#xa;else: history = []" style="text;html=1;align=left;fontSize=9;fontFamily=Courier New;spacingLeft=5;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="105" y="185" width="170" height="40" as="geometry" />
        </mxCell>
        
        <!-- Step 2: Load Config -->
        <mxCell id="step2" value="2. Load Guardrail Config" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="100" y="260" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="step2-text" value="config = load_config()&#xa;reads guardrails.json" style="text;html=1;align=left;fontSize=9;fontFamily=Courier New;spacingLeft=5;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="105" y="275" width="170" height="30" as="geometry" />
        </mxCell>
        
        <!-- Step 3: Input Guardrails -->
        <mxCell id="step3" value="3. Input Guardrails" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="100" y="340" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="step3-text" value="check_input(message, config)&#xa;• Length check&#xa;• Injection detection&#xa;• PII masking&#xa;• Topic check (optional)&#xa;→ (allowed, text, reason)" style="text;html=1;align=left;fontSize=9;fontFamily=Courier New;spacingLeft=5;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="105" y="355" width="170" height="70" as="geometry" />
        </mxCell>
        
        <!-- Blocked Branch -->
        <mxCell id="blocked-box" value="If Blocked" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="320" y="340" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="blocked-text" value="Return immediately:&#xa;{&#xa;  reply: blocked_message,&#xa;  guardrail: reason,&#xa;  tokens: 0, cost: null&#xa;}&#xa;NOT saved to session" style="text;html=1;align=left;fontSize=9;fontFamily=Courier New;spacingLeft=5;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="325" y="355" width="170" height="70" as="geometry" />
        </mxCell>
        
        <!-- Step 4: Build Prompt -->
        <mxCell id="step4" value="4. Build Prompt with History" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="100" y="460" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="step4-text" value="_build_prompt_with_history()&#xa;• Take last MAX_HISTORY_TURNS&#xa;• Format: &quot;User: ...&quot;&#xa;          &quot;Assistant: ...&quot;&#xa;• Add current message" style="text;html=1;align=left;fontSize=9;fontFamily=Courier New;spacingLeft=5;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="105" y="475" width="170" height="60" as="geometry" />
        </mxCell>
        
        <!-- Step 5: LLM Call -->
        <mxCell id="step5" value="5. Call LLM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="100" y="570" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="step5-text" value="ask_llm(prompt, MODEL)&#xa;→ {text, input_tokens,&#xa;    output_tokens, seconds,&#xa;    cost}&#xa;→ 502 if exception" style="text;html=1;align=left;fontSize=9;fontFamily=Courier New;spacingLeft=5;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="105" y="585" width="170" height="50" as="geometry" />
        </mxCell>
        
        <!-- Step 6: Output Guardrails -->
        <mxCell id="step6" value="6. Output Guardrails" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="100" y="670" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="step6-text" value="check_output(reply, config)&#xa;• Word count check&#xa;• Banned word detection&#xa;→ (allowed, reply, reason)&#xa;If blocked → return blocked" style="text;html=1;align=left;fontSize=9;fontFamily=Courier New;spacingLeft=5;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="105" y="685" width="170" height="50" as="geometry" />
        </mxCell>
        
        <!-- Step 7: Save to Session -->
        <mxCell id="step7" value="7. Save to Session (if session_id)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="320" y="570" width="180" height="110" as="geometry" />
        </mxCell>
        <mxCell id="step7-text" value="Append:&#xa;  {role: &quot;user&quot;, content}&#xa;  {role: &quot;assistant&quot;, content}&#xa;&#xa;Trim to MAX_HISTORY_TURNS*2&#xa;&#xa;turns_in_memory = &#xa;  len(session) // 2" style="text;html=1;align=left;fontSize=9;fontFamily=Courier New;spacingLeft=5;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="325" y="590" width="170" height="85" as="geometry" />
        </mxCell>
        
        <!-- Step 8: Return Response -->
        <mxCell id="step8" value="8. Return Success Response" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="320" y="710" width="180" height="100" as="geometry" />
        </mxCell>
        <mxCell id="step8-text" value="{&#xa;  reply,&#xa;  input_tokens, output_tokens,&#xa;  seconds, cost,&#xa;  turns_in_memory,&#xa;  guardrail (null or reason)&#xa;}" style="text;html=1;align=left;fontSize=9;fontFamily=Courier New;spacingLeft=5;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="325" y="730" width="170" height="75" as="geometry" />
        </mxCell>
        
        <!-- Arrows -->
        <mxCell id="arrow1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="step0" target="step1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="arrow2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="step1" target="step2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="arrow3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="step2" target="step3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="arrow4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#b85450;" edge="1" parent="1" source="step3" target="blocked-box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arrow4-label" value="if blocked" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=2" vertex="1" connectable="0" parent="arrow4">
          <mxGeometry x="-0.2" y="1" relative="1" as="geometry">
            <mxPoint y="-10" as="offset" />
          </mxGeometry>
        </mxCell>
        
        <mxCell id="arrow5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="step3" target="step4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arrow5-label" value="if allowed" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=2" vertex="1" connectable="0" parent="arrow5">
          <mxGeometry x="-0.2" y="1" relative="1" as="geometry">
            <mxPoint x="25" as="offset" />
          </mxGeometry>
        </mxCell>
        
        <mxCell id="arrow6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="step4" target="step5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="arrow7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="step5" target="step6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="arrow8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="step6" target="step7">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="190" y="760" />
              <mxPoint x="300" y="760" />
              <mxPoint x="300" y="625" />
            </Array>
          </mxGeometry>
        </mxCell>
        
        <mxCell id="arrow9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="step7" target="step8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Legend -->
        <mxCell id="legend-box2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="550" y="100" width="500" height="300" as="geometry" />
        </mxCell>
        <mxCell id="legend-title2" value="Key Variables at Each Step" style="text;html=1;align=left;fontSize=13;fontStyle=1;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="555" y="105" width="490" height="25" as="geometry" />
        </mxCell>
        
        <mxCell id="var1" value="history" style="text;html=1;align=left;fontSize=10;fontStyle=1;spacingLeft=10;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="560" y="140" width="480" height="15" as="geometry" />
        </mxCell>
        <mxCell id="var1-text" value="List of {role, content} dicts from sessions[session_id]&#xa;or [] if no session_id provided" style="text;html=1;align=left;fontSize=9;spacingLeft=20;" vertex="1" parent="1">
          <mxGeometry x="565" y="155" width="475" height="25" as="geometry" />
        </mxCell>
        
        <mxCell id="var2" value="MAX_HISTORY_TURNS" style="text;html=1;align=left;fontSize=10;fontStyle=1;spacingLeft=10;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="560" y="185" width="480" height="15" as="geometry" />
        </mxCell>
        <mxCell id="var2-text" value="From env (default 10). Only last N turns sent to LLM.&#xa;Each turn = 1 user message + 1 assistant message." style="text;html=1;align=left;fontSize=9;spacingLeft=20;" vertex="1" parent="1">
          <mxGeometry x="565" y="200" width="475" height="25" as="geometry" />
        </mxCell>
        
        <mxCell id="var3" value="allowed, text, reason" style="text;html=1;align=left;fontSize=10;fontStyle=1;spacingLeft=10;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="560" y="230" width="480" height="15" as="geometry" />
        </mxCell>
        <mxCell id="var3-text" value="From check_input():&#xa;  allowed = True/False&#xa;  text = cleaned message (PII masked)&#xa;  reason = None or &quot;blocked: ...&quot; or &quot;masked: ...&quot;" style="text;html=1;align=left;fontSize=9;spacingLeft=20;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="565" y="245" width="475" height="45" as="geometry" />
        </mxCell>
        
        <mxCell id="var4" value="prompt" style="text;html=1;align=left;fontSize=10;fontStyle=1;spacingLeft=10;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="560" y="295" width="480" height="15" as="geometry" />
        </mxCell>
        <mxCell id="var4-text" value="Built from last MAX_HISTORY_TURNS of history + current msg:&#xa;&quot;Continue this conversation:\n\nUser: ...\nAssistant: ...\n...&quot;" style="text;html=1;align=left;fontSize=9;spacingLeft=20;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="565" y="310" width="475" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="var5" value="turns_in_memory" style="text;html=1;align=left;fontSize=10;fontStyle=1;spacingLeft=10;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="560" y="345" width="480" height="15" as="geometry" />
        </mxCell>
        <mxCell id="var5-text" value="After saving: len(sessions[session_id]) // 2&#xa;Represents number of conversational turns stored." style="text;html=1;align=left;fontSize=9;spacingLeft=20;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="565" y="360" width="475" height="25" as="geometry" />
        </mxCell>
        
        <!-- Error Handling Box -->
        <mxCell id="errors-box" value="Error Responses" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="550" y="420" width="500" height="150" as="geometry" />
        </mxCell>
        
        <mxCell id="err1" value="404 - Session not found" style="text;html=1;align=left;fontSize=10;fontStyle=1;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="555" y="450" width="490" height="15" as="geometry" />
        </mxCell>
        <mxCell id="err1-text" value="session_id provided but not in sessions{}" style="text;html=1;align=left;fontSize=9;spacingLeft=20;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="560" y="465" width="485" height="15" as="geometry" />
        </mxCell>
        
        <mxCell id="err2" value="422 - Validation error" style="text;html=1;align=left;fontSize=10;fontStyle=1;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="555" y="485" width="490" height="15" as="geometry" />
        </mxCell>
        <mxCell id="err2-text" value="Message not 1-4000 chars (Pydantic validation)" style="text;html=1;align=left;fontSize=9;spacingLeft=20;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="560" y="500" width="485" height="15" as="geometry" />
        </mxCell>
        
        <mxCell id="err3" value="502 - LLM failure" style="text;html=1;align=left;fontSize=10;fontStyle=1;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="555" y="520" width="490" height="15" as="geometry" />
        </mxCell>
        <mxCell id="err3-text" value="Exception during ask_llm() call&#xa;(API timeout, invalid key, rate limit, etc.)" style="text;html=1;align=left;fontSize=9;spacingLeft=20;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="560" y="535" width="485" height="25" as="geometry" />
        </mxCell>
        
      </root>
    </mxGraphModel>
  </diagram>
